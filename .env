# ---------- Base de données (Supabase Postgres) ----------
# Connexion applicative via le pooler (port 6543)
DATABASE_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Connexion directe (port 5432) — utilisée uniquement par les migrations Prisma
DIRECT_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# ---------- Authentification admin (Auth.js v5) ----------
# Générer avec : openssl rand -base64 32
AUTH_SECRET="remplace-moi-par-une-valeur-aleatoire"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Compte admin créé par le seed
SEED_ADMIN_EMAIL="admin@starios.ma"
SEED_ADMIN_PASSWORD="Starios2026!"

# ---------- Emails transactionnels (Resend) ----------
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="Starios <devis@starios.ma>"
EMAIL_TO_ADMIN="contact@starios.ma"

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP="212661784716"
NEXT_PUBLIC_PHONE="06 61 78 47 16"
NEXT_PUBLIC_EMAIL="contact@starios.ma"

# ---------- Stockage des images (Supabase Storage) ----------
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key-serveur-uniquement"
